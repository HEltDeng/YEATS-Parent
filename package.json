{
  "name": "yeats-parent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.js",
    "package:acceptance": "node scripts/package.cjs acceptance",
    "package:production": "node scripts/package.cjs production"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "miniprogram-api-typings": "5.2.3",
    "miniprogram-automator": "0.12.1",
    "file-type-modern": "npm:file-type@21.3.4",
    "file-type": "file:tools/file-type-buffer-compat"
  },
  "overrides": {
    "jimp": "0.22.12",
    "file-type": "$file-type"
  },
  "engines": {
    "node": ">=20"
  }
}
